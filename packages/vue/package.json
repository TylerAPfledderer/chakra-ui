{
  "name": "@chakra-ui/vue",
  "version": "0.0.0",
  "description": "Vue 3 component library for Chakra UI - providers, composables, and styling",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "author": "Segun Adebayo <sage@adebayosegun.com>",
  "license": "MIT",
  "homepage": "https://chakra-ui.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/chakra-ui/chakra-ui",
    "directory": "packages/vue"
  },
  "keywords": [
    "chakra-ui",
    "vue",
    "vue3",
    "design-system",
    "style-system",
    "composables"
  ],
  "scripts": {
    "prepack": "tsx ../../scripts/conditions.ts",
    "postpack": "tsx ../../scripts/conditions.ts --restore",
    "build:fast": "tsx ../../scripts/build/main.ts",
    "build": "tsx ../../scripts/build/main.ts --dts",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@chakra-ui/system-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.13"
  },
  "exports": {
    ".": {
      "dev": "./src/index.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  }
}
